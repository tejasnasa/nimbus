# Every variable below is read by the API server. The uncommented ones are
# required: the process refuses to start without them and names the missing
# variable (see apps/api/src/lib/env.ts). Copy this file to `.env` and fill it in.

# ── Storage, auth and origin ──
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL="postgresql://user:password@localhost:5432/nimbus?sslmode=disable"
FRONTEND_URL=http://localhost:3000

# Transport is resolved from this URL, because the scheme alone is not reliable:
# `rediss://` always negotiates TLS; plain `redis://` is decided by host —
# loopback, a private range or a bare service name stays plaintext, and anything
# addressed by FQDN (a managed host) gets TLS. Set REDIS_TLS=true|false to
# override that for a host it gets wrong.
REDIS_URL="redis://localhost:6379"

# ── NimbusBot ──
# The bot's own user row. Workspace creation inserts it as an ADMIN member and
# bot replies are persisted under it, so it must reference a real user id.
BOT_USERID=your_nimbusbot_user_id

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email (Resend) ──
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=contact@example.com

# ── coturn ──
TURN_SECRET=your_turn_shared_secret_here
TURN_SERVER_URL=turn:YOUR_DROPLET_IP:3478
TURNS_SERVER_URL=turns:YOUR_DROPLET_IP:5349
EXTERNAL_IP=YOUR_DROPLET_IP

# ── Client (Next.js) ──
# Browser-visible, so these are inlined at build time.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# Spelled to pair with the server's BOT_USERID above. Used by the chat panel to
# render the bot's messages as bot messages, and by the workspace helpers to
# filter the bot out of member lists.
NEXT_PUBLIC_BOT_USERID=your_nimbusbot_user_id

# ── Optional ──
# Only needed by coturn's compose file, and by @better-auth/infra if you use it.
BETTER_AUTH_API_KEY=your_better_auth_api_key

AUTH_COOKIE_DOMAIN=

# ── AI free tier (operator) ──
# When a user has no BYOK key, chat replies draw on AI_API_KEY against
# AI_PROVIDER's AI_MODEL. Per-provider keys (OpenAI, Groq, DeepSeek, …) are
# configured per-user via the AI settings panel, not via env. Leave
# AI_API_KEY empty to disable the free tier — the chat is then disabled for
# anyone without their own key.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_FREE_DOC_LIMIT=5

# ── BYOK credential encryption ──
# REQUIRED. Master passphrase used to encrypt user-supplied API keys at rest;
# the API refuses to boot without it. Generate with `openssl rand -base64 48`.
# Rotation: add the old value to the *_PREVIOUS comma-separated list, restart,
# then re-issue all rows.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# ── Avatar storage (Cloudinary) ──
# Used by /api/upload/avatar-signature and the post-delete cleanup hook.
# Cloudinary uploads must be signed so the browser can set `overwrite: true`
# against a per-user `public_id` — unsigned uploads cannot set `overwrite`,
# which is the binding constraint for the derived-cleanup design (see plan §2.3).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
