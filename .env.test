# Test-suite environment.
#
# Committed intentionally: every value here is a throwaway local placeholder that
# matches docker-compose.test.yml. None of these are real credentials, and none
# grant access to anything. Production secrets live in the gitignored .env.
#
#   docker compose -f docker-compose.test.yml up -d
#   npx turbo run db:deploy --filter=@nimbus/db      # apply schema to nimbus_test

DATABASE_URL="postgresql://nimbus:nimbus@localhost:5434/nimbus_test"
REDIS_URL="redis://localhost:6381"

NODE_ENV=test

FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=test-only-secret-placeholder-not-a-real-credential-32chars

# OAuth / email providers are never called in tests; values only satisfy config.
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
RESEND_API_KEY=test-resend-api-key

# Recipient of the public contact form. The contact suite asserts the sent
# payload follows whatever this holds, so it must be a real address shape.
CONTACT_TO_EMAIL=contact@example.com

# NimbusBot identity. Referenced by workspace creation (bot ADMIN membership),
# bot message persistence, and bot history role-mapping.
BOT_USERID=test-bot-user-id

# LLM providers are always mocked/stubbed in tests (module mocks in units, a
# stub clientFactory for integration), so no provider-specific key needs to
# exist as an env var. The free tier is exercised by the quota and
# entitlements suites with a dummy key — never a real one.
AI_API_KEY=test-ai-api-key-placeholder
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_FREE_DOC_LIMIT=5

# BYOK credential encryption. Required for the credentialCrypto and
# aiCredential suites; without it, every credential test fails with a
# decryption error and the failure looks like a crypto bug.
AI_CREDENTIAL_ENCRYPTION_KEY=test-only-encryption-key-placeholder-not-a-real-credential

# LiveKit dev server from docker-compose.test.yml. `devkey` / `secret` is the
# development pair the server prints and accepts in --dev mode, not a credential.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Cloudinary is always mocked at the module boundary in tests; these values
# only satisfy startup reads so the API can boot under test.
CLOUDINARY_CLOUD_NAME=test-cloudinary-cloud-name
CLOUDINARY_API_KEY=test-cloudinary-api-key
CLOUDINARY_API_SECRET=test-cloudinary-api-secret

# Shared secret between the API's /internal/agent routes and the voice agent.
# A throwaway placeholder of the required length, not a credential.
NIMBUS_AGENT_SECRET=test-only-agent-secret-placeholder-not-a-real-credential
# Where an agent process started by the suites reaches the API under test.
NIMBUS_API_URL=http://localhost:3001
