# Test-suite environment.
#
# Committed intentionally: every value here is a throwaway local placeholder that
# matches docker-compose.test.yml. None of these are real credentials, and none
# grant access to anything. Production secrets live in the gitignored .env.
#
#   docker compose -f docker-compose.test.yml up -d
#   npx turbo run db:deploy --filter=@nimbus/db      # apply schema to nimbus_test

DATABASE_URL="postgresql://nimbus:nimbus@localhost:5434/nimbus_test"
REDIS_URL="redis://localhost:6381"

NODE_ENV=test

FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=test-only-secret-placeholder-not-a-real-credential-32chars

# OAuth / email providers are never called in tests; values only satisfy config.
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
RESEND_API_KEY=test-resend-api-key

# NimbusBot identity. Referenced by workspace creation (bot ADMIN membership),
# bot message persistence, and bot history role-mapping.
BOT_USERID=test-bot-user-id

# LLM providers are always mocked/stubbed in tests (module mocks in units, a stub
# server for integration), so these are placeholders to satisfy startup reads.
GROQ_API_KEY=test-groq-api-key
GROQ_MODEL=test-groq-model
GROQ_CANVAS_MODEL=test-groq-canvas-model
OPENAI_API_KEY=test-openai-api-key
OPENAI_MODEL=test-openai-model

# TURN is only ever signalled, never dialled, in tests.
TURN_SECRET=test-turn-secret
TURN_SERVER_URL=turn:127.0.0.1:3478
TURNS_SERVER_URL=turns:127.0.0.1:5349
EXTERNAL_IP=127.0.0.1
