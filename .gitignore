coverage

# Playwright: minted storage states and run artifacts
apps/web/e2e/.auth
apps/web/e2e/.playwright-report
apps/web/e2e/test-results

# The production smoke suite's session cookies — real credentials for real
# accounts, so they must never be tracked.
apps/web/e2e-prod/.auth
playwright-report
test-results

