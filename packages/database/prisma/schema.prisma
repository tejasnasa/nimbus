// Prisma schema for Nimbus — real-time collaborative workspace platform.
// Schema reference: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// better-auth user record. Authenticated via Google OAuth or email/password;
// identified across the app by `id`, which is also used for presence tracking.
// auto generated by better-auth
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  workspaceMembers WorkspaceMember[]
  messages      Message[]
  freeDocGenerationsUsed Int @default(0)
  /// Seconds of the in-call assistant this user has spent on the operator's
  /// free tier. Per user, not per workspace, so ten workspaces are not ten
  /// allowances.
  freeVoiceSecondsUsed Int @default(0)
  aiCredentials  AiCredential[]
  aiPreferences  AiFeaturePreference[]
  workspaceAiCredentialsCreated WorkspaceAiCredential[] @relation("CredentialCreatedBy")
  workspaceAiPreferencesUpdated WorkspaceAiPreference[] @relation("PreferenceUpdatedBy")
  aiCalls        AiCall[]

  @@unique([email])
  @@map("user")
}

/// Active login session managed by better-auth. One row per browser session;
/// the HTTP-only cookie references `token`.
// auto generated by better-auth
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// OAuth/credential provider link for a user (e.g. Google account tokens).
// auto generated by better-auth
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// better-auth verification token (email verification, password reset flows).
// auto generated by better-auth
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Collaborative workspace that groups documents, messages, and members.
/// URL-routed by `slugId` (auto-increment int), not by `id` (cuid).
model Workspace {
  id        String   @id @default(cuid())
  name      String
  description String?
  slugId    Int      @unique @default(autoincrement())
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inviteCode String @unique @default(cuid())

  members   WorkspaceMember[]
  messages  Message[]
  documents Document[]
  aiCredentials WorkspaceAiCredential[]
  aiPreferences WorkspaceAiPreference[]
  aiSettings    WorkspaceAiSettings?
  aiCalls       AiCall[]
}

/// Join table linking a User to a Workspace with an RBAC role.
model WorkspaceMember {
  id          String      @id @default(cuid())
  userId      String
  workspaceId String
  role        MemberRole  @default(MEMBER)
  joinedAt    DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

/// Chat message sent within a workspace. Delivered live via Socket.IO,
/// persisted here as the source of truth.
model Message {
  id          String      @id @default(cuid())
  content     String
  userId      String
  workspaceId String
  createdAt   DateTime    @default(now())
  /// Cloudinary delivery URL of an image attached to the message, or null.
  /// Only ever a URL under `nimbus/chat/<workspaceId>`; the API rejects any other.
  imageUrl    String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A collaborative document within a workspace — either a canvas or markdown doc.
/// Storage format depends on `type`: canvases serialize to `canvasData`,
/// markdown docs persist Yjs binary state to `yjsState`.
model Document {
  id          String      @id @default(cuid())
  title       String
  workspaceId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  type        DocumentType @default(CANVAS)
  /// Full Excalidraw elements array (JSON), debounce-saved every ~3s.
  canvasData  Json?
  /// Binary Yjs state (`Y.encodeStateAsUpdate`), debounce-saved every ~5s.
  yjsState    Bytes?
  /// One-shot AI-generated markdown seed; consumed (cleared) on first doc:join.
  initialContent String?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A user's encrypted API key for one AI provider (BYOK).
///
/// One row per (user, provider) — re-saving replaces the row, so the unique
/// constraint is the deduplication rule. The plaintext key never appears in
/// the database: `keyEnvelope` carries `nimbus1.<keyId>.<ivB64>.<tagB64>.<ctB64>`
/// produced by `apps/api/src/lib/ai/credentialCrypto.ts`, and `keyId` is the
/// identifier of the master key that encrypted it (so a key-rotation script
/// can select the rows that need rewriting). `keyFingerprint` is a
/// non-reversible ledger identity (`sha256(apiKey).slice(0,16)`), used to
/// dedupe at-rest entries without ever seeing the secret.
/// `validatedAt` is set by the save-time probe — a stored credential that
/// never validated is not safe to use.
model AiCredential {
  id             String   @id @default(cuid())
  userId         String
  providerId     String
  label          String?
  /// nimbus1.<keyId>.<ivB64>.<tagB64>.<ctB64>. Never plaintext. AAD-bound to
  /// `<userId>:<providerId>` so a row swapped to another user/provider fails
  /// to decrypt.
  keyEnvelope    String
  /// sha256(derivedKey).slice(0,8) — which master key encrypted this row.
  keyId          String
  /// sha256(apiKey).slice(0,16) — ledger identity, not a secret. Never
  /// returned over HTTP.
  keyFingerprint String
  /// "sk-…4f2a" — safe to return.
  maskedPreview  String
  /// Stamped by the save-time probe. null means the key was stored unvalidated.
  validatedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastUsedAt     DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId])
  @@map("ai_credential")
}

/// The user's chosen provider+model for an AI feature. Drives which BYOK
/// credential and model a chat / markdown / canvas request uses.
model AiFeaturePreference {
  id         String    @id @default(cuid())
  userId     String
  feature    AiFeature
  providerId String
  modelId    String
  /// Where the model id came from: `registry` (curated list), `catalog`
  /// (OpenRouter's live catalogue) or `custom` (a typed id whose capabilities
  /// were measured by a probe at save time).
  modelSource String @default("registry")
  /// Capabilities measured or copied server-side when the preference was saved.
  /// Consulted instead of the registry when `modelSource` is not `registry`.
  /// Never taken from the client.
  modelCapabilities String[] @default([])
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@map("ai_feature_preference")
}

/// An admin-managed, encrypted provider key that every member of the workspace
/// spends when they use AI there.
///
/// One row per (workspace, provider). The plaintext key never appears in the
/// database: `keyEnvelope` carries `nimbus1.<keyId>.<ivB64>.<tagB64>.<ctB64>`
/// produced by `apps/api/src/lib/ai/credentialCrypto.ts`, bound by AAD to the
/// workspace and provider so a row copied into another workspace fails to
/// decrypt.
model WorkspaceAiCredential {
  id             String    @id @default(cuid())
  workspaceId    String
  providerId     String
  label          String?
  /// nimbus1.<keyId>.<ivB64>.<tagB64>.<ctB64>, AAD `ai-credential:v2:<workspaceId>:<providerId>`.
  keyEnvelope    String
  /// sha256(derivedKey).slice(0,8) — which master key encrypted this row.
  keyId          String
  /// sha256(apiKey).slice(0,16) — ledger identity, not a secret. Never returned over HTTP.
  keyFingerprint String
  /// "sk-…4f2a" — safe to return.
  maskedPreview  String
  /// Which model kinds the save-time probe confirmed: ["text","transcription","speech"].
  verifiedKinds  String[]  @default([])
  /// Stamped by the save-time probe. null means the key was never validated.
  validatedAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastUsedAt     DateTime?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?     @relation("CredentialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, providerId])
  @@index([workspaceId])
  @@map("workspace_ai_credential")
}

/// The workspace's chosen provider and model for an AI feature. Drives which
/// credential and model a request in that workspace uses.
model WorkspaceAiPreference {
  id          String    @id @default(cuid())
  workspaceId String
  feature     AiFeature
  providerId  String
  modelId     String
  /// registry | catalog | custom. Voice features are always registry.
  modelSource String    @default("registry")
  /// Capabilities stored for catalogue and custom models (from the catalogue or
  /// the probe). Never taken from the client.
  modelCapabilities String[] @default([])
  /// Text-to-speech voice name, only meaningful for SPEECH.
  voice       String?
  updatedById String?
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy   User?     @relation("PreferenceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, feature])
  @@index([workspaceId])
  @@map("workspace_ai_preference")
}

/// Per-workspace AI switches that are independent of keys and models.
model WorkspaceAiSettings {
  workspaceId        String    @id
  /// Month-to-date spend ceiling in USD. Null means no cap.
  monthlySpendCapUsd Decimal?  @db.Decimal(10, 2)
  /// Admin switch for the in-call assistant, independent of keys.
  assistantEnabled   Boolean   @default(true)
  /// Whether the assistant may speak, or answers in chat only.
  assistantSpeaks    Boolean   @default(true)
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_settings")
}

/// One model call, successful or not. The per-workspace usage log.
model AiCall {
  id              String       @id @default(cuid())
  workspaceId     String?
  userId          String?
  feature         AiFeature
  providerId      String
  modelId         String
  source          AiCallSource
  status          AiCallStatus
  /// Curated reason (`invalid-key`, `provider-error`, `timeout`, `parse-failed`).
  /// Never provider text.
  errorReason     String?
  inputTokens     Int?
  outputTokens    Int?
  reasoningTokens Int?
  audioSeconds    Float?
  characters      Int?
  latencyMs       Int
  /// Estimated from the registry price table; null when the model has no price.
  costUsd         Decimal?     @db.Decimal(12, 6)
  createdAt       DateTime     @default(now())
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("ai_call")
}

/// Role-based access control levels for workspace membership.
enum MemberRole {
  /// Creator of the workspace; full control including deletion.
  OWNER
  /// Can manage documents and members, but not delete the workspace.
  ADMIN
  /// Read/write participant; NimbusBot is added as ADMIN to every workspace.
  MEMBER
}

/// Kind of collaborative document.
enum DocumentType {
  /// Infinite Excalidraw canvas; state stored in `Document.canvasData`.
  CANVAS
  /// Milkdown + Yjs rich text doc; state stored in `Document.yjsState`.
  MARKDOWN
}

/// The AI call sites that can be configured per workspace. Mirrors the
/// `AiFeature` type in `packages/types/src/ai/providers.ts`; kept here as an
/// enum so the database can enforce it.
enum AiFeature {
  /// NimbusBot chat replies.
  CHAT
  /// AI-generated markdown documents.
  MARKDOWN
  /// AI-generated canvas (Excalidraw) documents.
  CANVAS
  /// Reading an image (a photographed diagram).
  VISION
  /// Speech to text.
  TRANSCRIPTION
  /// Text to speech.
  SPEECH
  /// Text work done on a meeting transcript (summaries, translation, answers).
  MEETING
}

/// Whose key paid for a model call.
enum AiCallSource {
  /// The workspace's own stored key.
  BYOK
  /// The operator's free tier.
  FREE
}

/// How a model call ended.
enum AiCallStatus {
  /// The call completed.
  OK
  /// The provider or the pipeline failed.
  ERROR
  /// The resolver refused before any provider was called.
  REFUSED
  /// The caller aborted the call.
  CANCELLED
}
