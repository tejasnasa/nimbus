{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "AI_FREE_VOICE_SECONDS",
    "AI_SPEECH_MODEL",
    "AI_SPEECH_VOICE",
    "AI_TEST_BASE_URL",
    "AI_TRANSCRIBE_MODEL",
    "AI_VOICE_API_KEY",
    "AI_VOICE_BASE_URL"
  ],
  "tasks": {
    "build": {
      "env": ["DATABASE_URL", "NEXT_PUBLIC_BACKEND_URL"],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "NEXT_PUBLIC_BACKEND_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "NEXT_PUBLIC_BACKEND_URL"]
    },
    "db:deploy": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "LIVEKIT_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "NIMBUS_AGENT_SECRET",
        "NIMBUS_API_URL"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^db:generate", "db:generate"],
      "cache": false,
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "NODE_ENV",
        "LIVEKIT_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "NIMBUS_AGENT_SECRET",
        "NIMBUS_API_URL"
      ]
    }
  }
}
